# Copy this file to backend/.env and keep the real key local.
TRAVELMATE_LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
TRAVELMATE_VECTOR_BACKEND=auto
# Production quality path. Use hash only for explicit offline development.
TRAVELMATE_EMBEDDING_PROVIDER=sentence_transformers
TRAVELMATE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TRAVELMATE_EMBEDDING_VERSION=bge-small-zh-v1.5
TRAVELMATE_EMBEDDING_DEVICE=cpu
TRAVELMATE_EMBEDDING_BATCH_SIZE=32
# BAAI/bge-small-zh-v1.5 returns 512 dimensions; hash fallback may use its own configured dimension.
TRAVELMATE_EMBEDDING_DIMENSION=512
TRAVELMATE_EMBEDDING_ALLOW_FALLBACK=false
TRAVELMATE_INDEX_ROOT=
TRAVELMATE_INDEX_VERSION=
TRAVELMATE_INDEX_BACKUP_ROOT=backups/indexes
TRAVELMATE_RETRIEVAL_MIN_SCORE=0.4
TRAVELMATE_RETRIEVAL_TOP_K=3
TRAVELMATE_RETRIEVAL_DENSE_WEIGHT=0.55
TRAVELMATE_RETRIEVAL_LEXICAL_WEIGHT=0.45
TRAVELMATE_CORS_ORIGINS=http://127.0.0.1:5501,http://localhost:5501
TRAVELMATE_MAX_SESSIONS=1000
